# ==============================================================================
# WikiPulse Environment Configuration Example
# ==============================================================================

# Application
PROJECT_NAME="WikiPulse"
ENVIRONMENT="development"
DEBUG=true
LOG_LEVEL="INFO"
API_V1_STR="/api/v1"
SECRET_KEY="wikipulse_insecure_development_secret_key_change_in_production"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database (PostgreSQL + pgvector)
# For Docker: postgresql+asyncpg://postgres:postgres@postgres:5432/wikipulse
# For local fallback: sqlite+aiosqlite:///./wikipulse.db
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/wikipulse"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres"
POSTGRES_DB="wikipulse"
POSTGRES_HOST="localhost"
POSTGRES_PORT=5432
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10

# Redis (Hot counters, Sliding Windows, Cache, Distributed locks)
REDIS_URL="redis://localhost:6379/0"
REDIS_CACHE_TTL_SECONDS=300
REDIS_HOT_COUNTER_WINDOW_SECONDS=900

# Apache Kafka
KAFKA_BOOTSTRAP_SERVERS="localhost:9092"
KAFKA_CONSUMER_GROUP_PREFIX="wikipulse"
KAFKA_AUTO_OFFSET_RESET="latest"
KAFKA_ENABLE_AUTO_COMMIT=false
KAFKA_MAX_POLL_INTERVAL_MS=300000
KAFKA_RETRIES=3
KAFKA_RETRY_BACKOFF_MS=1000

# Kafka Topics
TOPIC_RECENT_CHANGE="wikimedia.recentchange"
TOPIC_ARTICLE_PROCESSED="wikimedia.article.processed"
TOPIC_TREND_DETECTED="wikimedia.trend.detected"
TOPIC_EMBEDDING_CREATED="wikimedia.embedding.created"
TOPIC_ANALYSIS_COMPLETED="wikimedia.analysis.completed"
TOPIC_DLQ="wikimedia.dlq"

# Ingestion Stream Settings
# Options: "wikimedia" (live SSE stream) or "synthetic" (realistic deterministic generator)
STREAM_MODE="synthetic"
WIKIMEDIA_STREAM_URL="https://stream.wikimedia.org/v2/stream/recentchange"
WIKIMEDIA_USER_AGENT="WikiPulse/1.0 (https://github.com/wikipulse/wikipulse; contact@wikipulse.local)"
SYNTHETIC_EVENTS_PER_SECOND=10
FILTER_BOTS=false
FILTER_MIN_BYTE_DIFF=10

# AI / LLM Configuration
# Provider selection: "gemini", "ollama", or "mock"
DEFAULT_LLM_PROVIDER="gemini"
LLM_FALLBACK_CHAIN="gemini,ollama,mock"

# Google Gemini API
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-1.5-flash"
GEMINI_TIMEOUT_SECONDS=15

# Ollama Local LLM
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="llama3.2:1b"
OLLAMA_EMBED_MODEL="all-minilm"
OLLAMA_TIMEOUT_SECONDS=30

# Embedding & Search
EMBEDDING_DIMENSION=384
EMBEDDING_MODEL="sentence-transformers/all-MiniLM-L6-v2"
HYBRID_SEARCH_TOP_K=10
HYBRID_SEARCH_VECTOR_WEIGHT=0.6
HYBRID_SEARCH_FTS_WEIGHT=0.4
RERANK_CANDIDATE_COUNT=20

# Trend Detection Thresholds
TREND_SPIKE_MULTIPLIER_THRESHOLD=3.0
TREND_MIN_EDITS_THRESHOLD=5
TREND_WINDOW_1M_WEIGHT=0.5
TREND_WINDOW_5M_WEIGHT=0.3
TREND_WINDOW_15M_WEIGHT=0.2
